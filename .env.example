# --- required ---
DATABASE_URL=postgres://foodbot:foodbot@localhost:5432/foodbot
REDIS_URL=redis://localhost:6379

# --- Google Gemini ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- WhatsApp (Meta Cloud API) ---
# Long-lived system-user access token from Meta Business Suite
WHATSAPP_TOKEN=
# Phone number ID from the WhatsApp account
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Must match the verify token you set in the Meta webhook dashboard
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Used to verify HMAC SHA-256 signatures on incoming webhooks
WHATSAPP_APP_SECRET=

# --- restaurant ---
RESTAURANT_NAME=Hungry Bird
# Delivery fee in paisa (6000 = ৳60)
RESTAURANT_DEFAULT_DELIVERY_FEE_PAISA=6000

# --- optional ---
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
LLM_MODEL=gemini-3.6-flash
LLM_DAILY_TOKEN_BUDGET=500000

# --- admin (for /admin/queues/dlq) ---
ADMIN_BASIC_AUTH_USER=admin
# MUST override in production (e.g. `openssl rand -hex 24`)
ADMIN_BASIC_AUTH_PASS=changeme

# --- rate limiting ---
# Disable entirely in dev/test with RATELIMIT_DISABLED=true
RATELIMIT_WEBHOOK_PER_MIN=30
RATELIMIT_CHAT_PER_MIN=20
RATELIMIT_DISABLED=false